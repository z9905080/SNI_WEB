PORT=8080
DATABASE_URL=root:sniweb@tcp(127.0.0.1:3306)/sniweb
PUBLIC_BASE_URL=http://localhost:5173
COOKIE_SECURE=false
DEV_ORIGINS=http://localhost:5173
STORAGE_DRIVER=disk
STORAGE_DISK_DIR=./tmp/picture

# STORAGE_DRIVER=s3 時使用（docker compose 的 MinIO）
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=sniweb
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://127.0.0.1:9000/sniweb

GA_MEASUREMENT_ID=
COUNTER_SCRIPT_URL=
